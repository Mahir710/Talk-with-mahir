import React, { useState } from 'react'
import { motion, AnimatePresence } from 'framer-motion'
import { Menu, X, Linkedin, Github, Mail, Feather } from 'lucide-react'

// Single-file React + Tailwind component for MAHIR TECH portfolio
// - Tailwind is expected to be configured in the project
// - Framer Motion is used for animations
// - Lucide icons are referenced (install lucide-react)
// - Replace placeholder asset URLs and API endpoint with your own

export default function MahirPortfolio() {
  const [mobileNavOpen, setMobileNavOpen] = useState(false)
  const [modalProject, setModalProject] = useState(null)
  const [dark, setDark] = useState(true)
  const [contactState, setContactState] = useState({ name: '', email: '', message: '', status: '' })

  const projects = [
    {
      id: 1,
      title: 'AeroCommerce',
      description: 'Headless e‑commerce platform with real‑time analytics.',
      img: 'https://images.unsplash.com/photo-1523475496153-3d6ccf5592f4?w=1200',
      tech: ['React', 'Node.js', 'GraphQL'],
      demo: '#'
    },
    {
      id: 2,
      title: 'Neon Chat',
      description: 'Real‑time messaging app with ML smart replies.',
      img: 'https://images.unsplash.com/photo-1518770660439-4636190af475?w=1200',
      tech: ['Next.js', 'Socket.io', 'TensorFlow.js'],
      demo: '#'
    },
    {
      id: 3,
      title: 'Vision AI',
      description: 'Computer vision pipeline for automated quality control.',
      img: 'https://images.unsplash.com/photo-1509395176047-4a66953fd231?w=1200',
      tech: ['Python', 'PyTorch', 'Docker'],
      demo: '#'
    }
  ]

  const services = [
    { title: 'Web Development', desc: 'Modern, performant web apps & PWAs.' },
    { title: 'Mobile Apps', desc: 'Cross‑platform mobile experiences with great UX.' },
    { title: 'AI Solutions', desc: 'Integrating machine learning & automation into products.' },
    { title: 'Branding & Digital Marketing', desc: 'Strategy, identity, and conversion‑focused campaigns.' }
  ]

  const testimonials = [
    { id: 1, name: 'Sara Khan', role: 'CTO - Stellar', text: 'MAHIR TECH delivered an outstanding product — fast, elegant and robust.' },
    { id: 2, name: 'Rafi Ahmed', role: 'Founder - Flux', text: 'A visionary developer with great design sensibility.' }
  ]

  async function submitContact(e) {
    e.preventDefault()
    setContactState(s => ({ ...s, status: 'sending' }))
    try {
      // Replace /api/contact with your server/email API
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: contactState.name, email: contactState.email, message: contactState.message })
      })
      if (res.ok) setContactState({ name: '', email: '', message: '', status: 'sent' })
      else setContactState(s => ({ ...s, status: 'error' }))
    } catch (err) {
      setContactState(s => ({ ...s, status: 'error' }))
    }
  }

  return (
    <div className={dark ? 'dark' : ''}>
      <div className="min-h-screen bg-gradient-to-b from-[#05060a] via-[#070816] to-[#04040a] text-slate-200">
        {/* Decorative animated background (particles + gradient) */}
        <div className="fixed inset-0 -z-10 overflow-hidden">
          <div className="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-[#081021]/40 via-transparent to-transparent opacity-60" />
          <div className="absolute inset-0 animate-[spin_120s_linear_infinite] bg-[conic-gradient(from_180deg_at_50%_50%,rgba(79,70,229,0.06),transparent,rgba(6,182,212,0.06))]" />
        </div>

        {/* NAV */}
        <header className="sticky top-0 z-40 backdrop-blur-md bg-black/20 border-b border-white/6">
          <div className="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
            <div className="flex items-center gap-3">
              <div className="w-10 h-10 rounded-xl bg-gradient-to-br from-cyan-400 to-violet-600 flex items-center justify-center shadow-2xl"> 
                <span className="font-extrabold tracking-tight text-black">MT</span>
              </div>
              <div>
                <div className="text-lg font-bold">MAHIR TECH</div>
                <div className="text-xs text-slate-400">Innovating the Future with Technology</div>
              </div>
            </div>

            <nav className="hidden md:flex items-center gap-6">
              <a href="#about" className="hover:underline">About</a>
              <a href="#projects" className="hover:underline">Projects</a>
              <a href="#services" className="hover:underline">Services</a>
              <a href="#contact" className="hover:underline">Contact</a>
              <button aria-label="toggle theme" onClick={() => setDark(d => !d)} className="ml-2 px-3 py-1 rounded-lg bg-white/5 hover:bg-white/8">{dark ? 'Dark' : 'Light'}</button>
            </nav>

            <div className="md:hidden">
              <button onClick={() => setMobileNavOpen(v => !v)} aria-label="menu" className="p-2 rounded-md bg-white/5">
                {mobileNavOpen ? <X size={18} /> : <Menu size={18} />}
              </button>
            </div>
          </div>

          <AnimatePresence>
            {mobileNavOpen && (
              <motion.div initial={{ opacity: 0, y: -8 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0 }} className="md:hidden">
                <div className="px-6 pb-4 flex flex-col gap-2">
                  <a href="#about" onClick={() => setMobileNavOpen(false)}>About</a>
                  <a href="#projects" onClick={() => setMobileNavOpen(false)}>Projects</a>
                  <a href="#services" onClick={() => setMobileNavOpen(false)}>Services</a>
                  <a href="#contact" onClick={() => setMobileNavOpen(false)}>Contact</a>
                </div>
              </motion.div>
            )}
          </AnimatePresence>
        </header>

        {/* HERO */}
        <main className="max-w-6xl mx-auto px-6 py-16 flex flex-col gap-12">
          <section className="min-h-[70vh] flex flex-col-reverse md:flex-row items-center gap-8">
            <div className="flex-1">
              <motion.h1 initial={{ opacity: 0, y: 12 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.1 }} className="text-4xl md:text-6xl font-extrabold leading-tight">
                MAHIR TECH
                <div className="mt-2 text-2xl font-medium text-slate-400">Innovating the Future with Technology</div>
              </motion.h1>

              <motion.p initial={{ opacity: 0 }} animate={{ opacity: 1 }} transition={{ delay: 0.25 }} className="mt-6 max-w-xl text-slate-300">
                I build modern web and mobile applications, design intuitive product experiences, and integrate AI to solve real-world problems. I focus on clean code, delightful UX, and measurable results.
              </motion.p>

              <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} transition={{ delay: 0.4 }} className="mt-8 flex gap-4">
                <a href="#projects" className="inline-flex items-center gap-3 px-6 py-3 rounded-full bg-gradient-to-r from-cyan-400 to-violet-600 shadow-lg backdrop-blur-md hover:scale-[1.02] transform transition">
                  View My Work
n                </a>
                <a href="#contact" className="inline-flex items-center gap-2 px-4 py-3 rounded-lg border border-white/6">Contact Me</a>
              </motion.div>

              <div className="mt-6 flex items-center gap-4">
                <a href="#" aria-label="LinkedIn" className="p-3 rounded-full bg-white/3 hover:bg-white/6"><Linkedin size={16} /></a>
                <a href="#" aria-label="GitHub" className="p-3 rounded-full bg-white/3 hover:bg-white/6"><Github size={16} /></a>
                <a href="#" aria-label="Email" className="p-3 rounded-full bg-white/3 hover:bg-white/6"><Mail size={16} /></a>
              </div>
            </div>

            <motion.div className="flex-1 flex justify-center" initial={{ opacity: 0, scale: 0.95 }} animate={{ opacity: 1, scale: 1 }} transition={{ delay: 0.3 }}>
              <div className="w-[260px] h-[340px] rounded-2xl bg-white/5 backdrop-blur-md border border-white/6 p-4 shadow-2xl transform-gpu hover:rotate-1 transition will-change-transform">
                <div className="w-full h-full rounded-xl overflow-hidden shadow-inner relative">
                  <img src="https://images.unsplash.com/photo-1541807084-5c52b6b5e5b5?w=800" alt="profile" className="object-cover w-full h-full" />
                  <div className="absolute left-3 bottom-3 bg-gradient-to-r from-cyan-400 to-violet-600 px-3 py-1 rounded-full text-black font-semibold text-sm">Lead Developer</div>
                </div>
              </div>
            </motion.div>
          </section>

          {/* ABOUT */}
          <section id="about" className="py-8">
            <div className="grid md:grid-cols-3 gap-8 items-center">
              <div className="md:col-span-2">
                <h2 className="text-2xl font-bold">About Me</h2>
                <p className="mt-3 text-slate-300 max-w-2xl">Hi — I’m MAHIR. I design and build modern web applications, mobile solutions, and AI integrations that help businesses scale. My approach blends pixel‑perfect design with robust engineering: clean architecture, automated testing, and continuous delivery.</p>

                <div className="mt-6 flex flex-wrap gap-3">
                  {['Web Development', 'App Design', 'AI Solutions', 'DevOps', 'UI/UX', 'E‑commerce'].map(skill => (
                    <motion.span key={skill} whileHover={{ scale: 1.05 }} className="px-3 py-1 rounded-full bg-gradient-to-r from-white/4 to-white/2 border border-white/6 text-sm">{skill}</motion.span>
                  ))}
                </div>
              </div>

              <div className="flex justify-center md:justify-end">
                <div className="w-44 h-44 rounded-2xl bg-gradient-to-br from-cyan-400/20 to-violet-600/20 p-1 backdrop-blur-md border border-white/6">
                  <img src="https://images.unsplash.com/photo-1545996124-1f8a1c0a9e18?w=400" alt="profile" className="w-full h-full object-cover rounded-xl" />
                </div>
              </div>
            </div>
          </section>

          {/* PROJECTS */}
          <section id="projects" className="py-8">
            <h2 className="text-2xl font-bold">Selected Projects</h2>
            <div className="mt-6 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
              {projects.map(p => (
                <motion.div key={p.id} whileHover={{ y: -6 }} className="rounded-xl overflow-hidden bg-white/3 border border-white/6 backdrop-blur-md">
                  <div className="relative h-44">
                    <img src={p.img} alt={p.title} className="object-cover w-full h-full" />
                    <div className="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent" />
                    <div className="absolute left-4 bottom-4">
                      <div className="text-white font-semibold text-lg">{p.title}</div>
                      <div className="text-sm text-white/80">{p.description}</div>
                    </div>
                  </div>
                  <div className="p-4 flex items-center justify-between">
                    <div className="flex gap-2">
                      {p.tech.map(t => <span key={t} className="text-xs px-2 py-1 bg-white/5 rounded-full">{t}</span>)}
                    </div>
                    <div className="flex items-center gap-2">
                      <button onClick={() => setModalProject(p)} className="px-3 py-1 rounded-lg bg-gradient-to-r from-cyan-400 to-violet-600 text-black font-semibold">Details</button>
                      <a href={p.demo} target="_blank" rel="noreferrer" className="px-3 py-1 rounded-lg border border-white/6">Live</a>
                    </div>
                  </div>
                </motion.div>
              ))}
            </div>

            {/* Modal for project */}
            <AnimatePresence>
              {modalProject && (
                <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }} className="fixed inset-0 z-50 flex items-center justify-center p-6">
                  <motion.div initial={{ scale: 0.95 }} animate={{ scale: 1 }} exit={{ scale: 0.95 }} className="max-w-3xl w-full bg-black/90 rounded-2xl border border-white/6 p-6">
                    <div className="flex items-start justify-between gap-4">
                      <div>
                        <h3 className="text-xl font-bold">{modalProject.title}</h3>
                        <p className="mt-2 text-slate-300">{modalProject.description}</p>
                        <div className="mt-4 flex gap-2">{modalProject.tech.map(t => <span key={t} className="text-xs px-2 py-1 bg-white/5 rounded-full">{t}</span>)}</div>
                        <div className="mt-6 flex gap-3">
                          <a href={modalProject.demo} className="px-4 py-2 rounded-lg bg-gradient-to-r from-cyan-400 to-violet-600 text-black font-semibold">Open Demo</a>
                          <button onClick={() => setModalProject(null)} className="px-4 py-2 rounded-lg border">Close</button>
                        </div>
                      </div>
                      <div className="w-40 h-28 overflow-hidden rounded-lg">
                        <img src={modalProject.img} alt={modalProject.title} className="object-cover w-full h-full" />
                      </div>
                    </div>
                  </motion.div>
                </motion.div>
              )}
            </AnimatePresence>
          </section>

          {/* SERVICES */}
          <section id="services" className="py-8">
            <h2 className="text-2xl font-bold">Services</h2>
            <div className="mt-6 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
              {services.map(s => (
                <motion.div key={s.title} whileHover={{ y: -6 }} className="p-5 rounded-xl bg-white/3 border border-white/6 backdrop-blur-md">
                  <div className="text-lg font-semibold">{s.title}</div>
                  <p className="mt-2 text-slate-300 text-sm">{s.desc}</p>
                </motion.div>
              ))}
            </div>
          </section>

          {/* TESTIMONIALS (optional) */}
          <section className="py-8">
            <h2 className="text-2xl font-bold">Testimonials</h2>
            <div className="mt-6 space-y-4">
              {testimonials.map(t => (
                <motion.div key={t.id} whileHover={{ scale: 1.01 }} className="p-4 rounded-lg bg-white/3 border border-white/6">
                  <div className="font-medium">{t.name} <span className="text-sm text-slate-400">— {t.role}</span></div>
                  <div className="mt-2 text-slate-300">"{t.text}"</div>
                </motion.div>
              ))}
            </div>
          </section>

          {/* CONTACT */}
          <section id="contact" className="py-8">
            <h2 className="text-2xl font-bold">Contact</h2>
            <div className="mt-6 grid md:grid-cols-2 gap-6">
              <form onSubmit={submitContact} className="space-y-4">
                <input required value={contactState.name} onChange={e => setContactState(s => ({ ...s, name: e.target.value }))} placeholder="Your name" className="w-full px-4 py-3 rounded-lg bg-white/5 border border-white/6" />
                <input required value={contactState.email} onChange={e => setContactState(s => ({ ...s, email: e.target.value }))} placeholder="Your email" className="w-full px-4 py-3 rounded-lg bg-white/5 border border-white/6" />
                <textarea required value={contactState.message} onChange={e => setContactState(s => ({ ...s, message: e.target.value }))} placeholder="Message" rows={6} className="w-full px-4 py-3 rounded-lg bg-white/5 border border-white/6" />
                <div>
                  <button type="submit" className="px-5 py-3 rounded-full bg-gradient-to-r from-cyan-400 to-violet-600 text-black font-semibold">Send Message</button>
                  <span className="ml-4 text-sm text-slate-400">{contactState.status === 'sending' ? 'Sending...' : contactState.status === 'sent' ? 'Sent — thank you!' : contactState.status === 'error' ? 'Error, please try again.' : ''}</span>
                </div>
              </form>

              <div className="p-6 rounded-xl bg-white/3 border border-white/6">
                <h3 className="font-semibold">Get in touch</h3>
                <p className="mt-2 text-slate-300">Prefer email? Send a message to <a href="mailto:hello@mahirte.ch" className="underline">hello@mahirte.ch</a></p>
                <div className="mt-6 flex gap-3">
                  <a href="#" className="px-4 py-2 rounded-lg bg-white/5 flex items-center gap-2"><Linkedin size={16}/> LinkedIn</a>
                  <a href="#" className="px-4 py-2 rounded-lg bg-white/5 flex items-center gap-2"><Github size={16}/> GitHub</a>
                </div>

                <div className="mt-6 text-sm text-slate-400">Or connect on social:</div>
                <div className="mt-3 flex gap-3">
                  <a className="p-3 rounded-full bg-white/4"><Linkedin size={16}/></a>
                  <a className="p-3 rounded-full bg-white/4"><Github size={16}/></a>
                  <a className="p-3 rounded-full bg-white/4"><Mail size={16}/></a>
                </div>
              </div>
            </div>
          </section>

          <footer className="py-8 text-center text-sm text-slate-500">© {new Date().getFullYear()} MAHIR TECH — Built with ❤️ using React + Tailwind + Framer Motion</footer>
        </main>
      </div>
    </div>
  )
}
